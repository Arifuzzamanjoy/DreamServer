services:
  dreamreason:
    build:
      context: ./extensions/services/dreamreason
    image: ods-dreamreason:local
    container_name: ods-dreamreason
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      # Peer traffic goes through LiteLLM, never straight to a peer's
      # llama-server (ODS-RUNTIME-MESH-LLM-LOCAL-ROUTE).
      - MESH_LITELLM_URL=${MESH_LITELLM_URL:-http://litellm:4000/v1}
      - LITELLM_KEY=${LITELLM_KEY:-}
      # Capped at 3: accuracy drops materially from 5 to 10 agents
      # (Ringelmann, arXiv 2606.02646). Never "all idle peers".
      - MESH_FANOUT=${MESH_FANOUT:-3}
      - MESH_JUDGE_MODEL=${MESH_JUDGE_MODEL:-local}
      - MESH_CONSENSUS_THRESHOLD=${MESH_CONSENSUS_THRESHOLD:-0.85}
      - MESH_PEER_TIMEOUT_SECONDS=${MESH_PEER_TIMEOUT_SECONDS:-120}
      # Bounds straggler latency; 0 disables.
      - MESH_MAX_TOKENS=${MESH_MAX_TOKENS:-512}
      - MESH_MODEL_NAME=${MESH_MODEL_NAME:-mesh}
      - MESH_DEFAULT_SKILLS=${MESH_DEFAULT_SKILLS:-}
      - MESH_SHOW_RATIONALE=${MESH_SHOW_RATIONALE:-false}
      - MESH_ROUTER=${MESH_ROUTER:-keyword}
      # Route on measured performance rather than declared skills. The ledger
      # fills from ordinary traffic: every contested selection is one
      # observation of who actually wins at a skill.
      - MESH_USE_LEDGER=${MESH_USE_LEDGER:-true}
      - MESH_LEDGER_PATH=${MESH_LEDGER_PATH:-/data/mesh-capability.json}
      - MESH_LEDGER_MIN_OBSERVATIONS=${MESH_LEDGER_MIN_OBSERVATIONS:-5}
      # Peers only where a specialist was confidently identified, rather than
      # filling the budget with whoever was left.
      - MESH_ESCALATE_ONLY=${MESH_ESCALATE_ONLY:-false}
      - MESH_LOCAL_MODEL=${MESH_LOCAL_MODEL:-local}
    volumes:
      # The ledger is the only state this service keeps. Without a mount it is
      # relearned from zero on every restart, and a routing hint that resets
      # whenever the container cycles is not a hint.
      - ./data:/data:z
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${DREAMREASON_PORT:-9200}:9200"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9200/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
